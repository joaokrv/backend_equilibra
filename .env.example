# ─── CONFIGURAÇÕES DE SEGURANÇA ──────────────────────────────────────────────
# Gerar via: openssl rand -hex 32
JWT_SECRET=SUBSTITUA_POR_HEX_64_CHARS_MINIMO

# Salt adicional para hash de senhas (Pepper) — diferente do JWT_SECRET
AUTH_PEPPER=SUBSTITUA_POR_HEX_64_CHARS_MINIMO

# CORS — Origens permitidas (separar por vírgula)
# Produção: apenas o domínio Vercel
CORS_ALLOWED_ORIGINS=https://SEU_APP.vercel.app

# ─── CONFIGURAÇÕES DE BANCO DE DADOS (PostgreSQL) ────────────────────────────
DB_URL=jdbc:postgresql://HOST:PORT/DB?sslmode=require
DB_USERNAME=postgres.SEU_PROJECT_ID
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
DB_NAME=postgres

# ─── CONFIGURAÇÕES DE E-MAIL (SMTP Brevo) ────────────────────────────────────
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=SEU_USERNAME@smtp-brevo.com
MAIL_PASSWORD=SUBSTITUA_POR_API_KEY_BREVO
MAIL_FROM=SEU_EMAIL@dominio.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_ENABLED=false

BREVO_API_FALLBACK_ENABLED=true
BREVO_FROM_NAME=NomeDoApp
BREVO_API_KEY=SUBSTITUA_POR_CHAVE_REAL

# ─── INTEGRAÇÕES FINANCEIRAS ──────────────────────────────────────────────────
BRAPI_TOKEN=SUBSTITUA_POR_TOKEN_BRAPI
AWESOME_API_KEY=SUBSTITUA_POR_CHAVE_AWESOME
HG_API_KEY=SUBSTITUA_POR_CHAVE_HG
SPRING_PROFILES_ACTIVE=dev
